{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build",
    "build:trip-preview": "node scripts/sync-trip-preview.mjs --build",
    "hosting:proof": "node scripts/aws-hosting-proof.mjs",
    "sync:trip-preview": "node scripts/sync-trip-preview.mjs",
    "start": "node scripts/run-vinext.mjs start",
    "test": "node scripts/run-vinext.mjs build && node --test tests/rendered-html.test.mjs tests/trip-preview-integration.test.mjs",
    "e2e:aws": "node tests/aws-public-e2e.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@types/three": "^0.185.4",
    "drizzle-orm": "0.45.2",
    "gsap": "^3.15.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
