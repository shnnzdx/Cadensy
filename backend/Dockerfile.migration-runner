# One-off Alembic runner for reviewed manual releases.  It is intentionally a
# separate image from the HTTP runtime image so the latter stays minimal.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN useradd --create-home --shell /usr/sbin/nologin appuser

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY alembic.ini .
COPY alembic ./alembic
COPY app ./app
COPY data ./data

USER appuser

# Release operators override this command only with the reviewed sequence:
# validate legacy compatibility -> stamp f9 -> upgrade head -> verify.
CMD ["python", "-m", "app.db.legacy_schema_compat"]
